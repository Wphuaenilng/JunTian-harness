apps/desktop/.runtime/
apps/desktop/release/

# Scratch stores for the two keyless harnesses. A hard Ctrl-C can leave them behind,
# and they contain a live session dir plus a token-bearing info file.
.ci-smoke/
.stall-demo/

# Runtime skills the kernel plants into the session cwd — not source.
.rivet/
