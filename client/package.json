{
  "name": "tianshu-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-built Web/desktop client for the Tianshu sidecar (frontend only — never touches the kernel)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sidecar": "node scripts/launch-sidecar.mjs",
    "sidecar:health": "node scripts/check-health.mjs",
    "gen:types": "node scripts/gen-protocol-types.mjs",
    "check:types": "node scripts/gen-protocol-types.mjs --check",
    "check:ledger": "node scripts/protocol-ledger.mjs --check",
    "check:nongoals": "node scripts/check-nongoals.mjs",
    "check:traps": "node scripts/check-traps.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev": "node scripts/serve-client.mjs --dev",
    "start": "node scripts/serve-client.mjs",
    "build": "corepack pnpm -r build",
    "typecheck": "tsc -b packages/client-core",
    "test": "node --test packages/*/test/*.test.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.9.2"
  }
}
