# ci-client.workflow.yml.example — the plan's 贯穿项 as a GitHub Actions job, ready to drop in.
#
# NOT ACTIVE ON PURPOSE: it lives in client/scripts/ because adding anything to this repo's
# shared `.github/workflows/` (which already holds ci.yml and three build-*.yml) is an
# infrastructure change the owner decides. To wire it:
#
#   mv client/scripts/ci-client.workflow.yml.example .github/workflows/client-gates.yml
#
# Everything below follows the house style of `.github/workflows/ci.yml` (setup-node@v4 with
# node 24 and cache: npm, npm ci, explicit read-only permissions).
#
# What it runs is only what already passes locally as one command:
#   node scripts/ci-smoke.mjs   → drift gate + protocol-ledger gate + non-goals gate + docs
#                                 gate + §5.2 trap gate, then a KEYLESS sidecar boot: /health
#                                 handshake, create session, GET /tasks, and the send path.
#
# Zero-spend is structural, not hopeful: ci-smoke writes an empty provider config for the
# process and points RIVET_CONFIG_PATH at it (without that env override the runtime falls back
# to the user's real config root, where a key may live), then skips the send step unless
# /health reports configured:false. So a CI secret could not be billed by this job even if one
# were present — and none is: no secrets are referenced here.
#
# The kernel must be built first: launch-sidecar.mjs looks for ../dist/cli/entry.js and says
# so explicitly if it is missing.

name: client gates

on:
  push:
    paths:
      - 'client/**'
      - 'src/server/protocol.ts'   # the mirrored contract: change it and the drift gate must speak
      - 'package.json'
      - 'package-lock.json'
  pull_request:
    paths:
      - 'client/**'
      - 'src/server/protocol.ts'
  workflow_dispatch:

jobs:
  gates:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    strategy:
      matrix:
        # 根 package.json 的 engines 是 ">=24"（与 ci.yml 同档）。客户端单测直接用 node 跑
        # .ts，靠的是 Node 的类型擦除，需要 22.18+/24。
        node-version: [24]
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: npm

      - name: Install and build the kernel the sidecar runs from
        run: |
          npm ci
          npm run build

      # client/ has no `packageManager` field, so this uses corepack's default pnpm — the
      # version this workspace was verified with locally is 12.10.1. If you want the job to
      # be version-pinned, add packageManager to client/package.json (or pnpm/action-setup)
      # rather than trusting a moving default.
      - name: Enable corepack
        working-directory: client
        run: corepack enable

      - name: Install workspace
        working-directory: client
        run: corepack pnpm install --frozen-lockfile   # client/pnpm-lock.yaml exists

      - name: drift + ledger + non-goals + docs + traps + theme + layers, then keyless sidecar smoke
        working-directory: client
        run: node scripts/ci-smoke.mjs

      - name: unit tests (node:test across the workspace)
        working-directory: client
        run: corepack pnpm test

      - name: client-core typecheck
        working-directory: client
        run: corepack pnpm typecheck

      - name: build the web bundle
        working-directory: client
        run: corepack pnpm --filter @tianshu/app-web build

      # Deliberately NOT run here:
      #  - verify-desktop.mjs: needs an Electron binary plus a CDP-attached window;
      #  - the paid acceptance scripts (accept-*, stall-demo): they need a provider key, and
      #    nothing in this job has or needs one. Both are recorded in client/README.md as
      #    local/manual steps.
